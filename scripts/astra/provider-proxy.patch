+def provider_proxy_preflight(base_url: str, proxy: str) -> bool:
+    """Credential-free HEAD: verify CONNECT and relay TLS, never call a model."""
+    validated = validate_provider_proxy(base_url, proxy)
+    assert validated is not None
+    try:
+        result = subprocess.run(
+            [
+                "curl",
+                "-q",
+                "--silent",
+                "--head",
+                "--output",
+                os.devnull,
+                "--write-out",
+                "%{http_code} %{ssl_verify_result}",
+                "--connect-timeout",
+                "2",
+                "--max-time",
+                "5",
+                "--noproxy",
+                "",
+                "--proxy",
+                validated,
+                base_url + "/",
+            ],
+            capture_output=True,
+            text=True,
+            timeout=6,
+            check=False,
+        )
+    except (OSError, subprocess.TimeoutExpired):
+        return False
+    fields = result.stdout.split()
+    return (
+        result.returncode == 0
+        and len(fields) == 2
+        and fields[0].isdigit()
+        and 200 <= int(fields[0]) <= 599
+        and fields[1] == "0"
+    )
+
