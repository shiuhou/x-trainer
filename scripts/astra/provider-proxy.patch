+def validate_provider_proxy(base_url: str, proxy: str | None) -> str | None:
+    """Validate a local provider route, without a fixed proxy-port allowlist."""
+    if proxy is None:
+        return None
+    try:
+        parsed = urlsplit(proxy)
+        if (
+            base_url != APPROVED_RELAY
+            or parsed.scheme not in {"http", "https"}
+            or parsed.hostname not in {"localhost", "127.0.0.1", "::1"}
+            or parsed.username is not None
+            or parsed.password is not None
+            or parsed.path not in {"", "/"}
+            or parsed.query
+            or parsed.fragment
+            or any(c.isspace() for c in proxy)
+        ):
+            raise ValueError
+        port = (
+            parsed.port
+            if parsed.port is not None
+            else (443 if parsed.scheme == "https" else 80)
+        )
+        if not 1 <= port <= 65535:
+            raise ValueError
+    except ValueError:
+        raise S5Error(
+            "invalid_provider_configuration",
+            "proxy must be a local HTTP(S) endpoint for the configured relay",
+        ) from None
+    host = "[::1]" if parsed.hostname == "::1" else "127.0.0.1"
+    return f"{parsed.scheme}://{host}:{port}"
+
+
+def desktop_provider_proxies() -> list[str]:
+    """Read desktop proxy addresses as data, including saved settings when off.
+
+    Auto mode is an explicit application choice, independent of the desktop's
+    global toggle. Never scan listening ports or connect to unknown services.
+    """
+    candidates: list[str] = []
+    for protocol in ("https", "http"):
+        values = []
+        for key in ("host", "port"):
+            try:
+                result = subprocess.run(
+                    ["gsettings", "get", f"org.gnome.system.proxy.{protocol}", key],
+                    capture_output=True,
+                    text=True,
+                    timeout=1,
+                    check=False,
+                )
+            except (OSError, subprocess.TimeoutExpired):
+                return candidates
+            values.append(result.stdout.strip().strip("'\""))
+        host, port = values
+        # GNOME's https section identifies an HTTP CONNECT proxy for HTTPS
+        # destinations; it does not mean a TLS connection to the proxy itself.
+        if host in {"localhost", "127.0.0.1", "::1"} and port.isdecimal():
+            candidates.append(f"http://{'[::1]' if host == '::1' else host}:{port}")
+    return candidates
+
